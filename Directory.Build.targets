<Project>
  <!--
    ECommons is a vendored submodule: its own warnings aren't ours to fix, and they'd bury real ones from our code.
    This is a .targets (not .props) file because ECommons.csproj sets NoWarn itself without appending, and
    .targets files are applied after the project body, so this addition survives.
    When bumping ECommons, add any new upstream-only codes here; never silence warnings in SupermarketSweep this way.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ECommons'">
    <NoWarn>$(NoWarn);CS1587;CS0612;CS9107</NoWarn>
  </PropertyGroup>
</Project>
